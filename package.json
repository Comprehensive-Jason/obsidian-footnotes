{
  "name": "obsidian-footnotes",
  "version": "0.3.0-beta.2",
  "description": "",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit && node esbuild.config.mjs production",
    "lint": "eslint src test",
    "knip": "knip",
    "architecture": "node scripts/architecture-artifact.mjs",
    "mutation": "cross-env FC_NUM_RUNS=25 stryker run",
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "test:smoke": "node scripts/smoke-test.mjs",
    "oracle": "node scripts/oracle/run-oracle.mjs",
    "version": "node scripts/version-bump.mjs && git add manifest.json manifest-beta.json versions.json"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "remark-footnotes": "2.0.0",
    "remark-math": "3.0.1",
    "remark-parse": "8.0.3"
  },
  "devDependencies": {
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.38.6",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/node": "^22.20.1",
    "@vitest/coverage-v8": "^4.1.11",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.1",
    "fast-check": "^4.9.0",
    "knip": "^6.32.1",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm-footnote": "^2.1.0",
    "mdast-util-math": "^3.0.0",
    "micromark-extension-gfm-footnote": "^2.1.0",
    "micromark-extension-math": "^3.1.0",
    "obsidian": "^1.13.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "trim": "0.0.3"
  },
  "knip": {
    "entry": [
      "scripts/generate-corpora.ts",
      "scripts/oracle/plugin-facts.ts",
      "scripts/oracle/inapp-*.js",
      "scripts/strip-inkscape-icons.mjs",
      "scripts/readme-gifs/record.mjs",
      "scripts/readme-gifs/*.js"
    ],
    "ignore": [
      "vitest.stryker.config.mts"
    ],
    "ignoreBinaries": [
      "Obsidian.com",
      "ffmpeg"
    ],
    "ignoreDependencies": [
      "electron"
    ]
  }
}
