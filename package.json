{
  "name": "obsidian-footnotes",
  "version": "0.3.0-beta.8",
  "description": "",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit && node esbuild.config.mjs production",
    "lint": "eslint src test",
    "knip": "knip",
    "architecture": "node scripts/architecture-artifact.mjs",
    "mutation": "cross-env FC_NUM_RUNS=25 stryker run",
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "test:smoke": "node scripts/smoke-test.mjs",
    "tests:stop": "node scripts/stop-test-runs.mjs",
    "tests:resume": "node scripts/stop-test-runs.mjs --resume",
    "oracle": "node scripts/oracle/run-oracle.mjs",
    "version": "node scripts/version-bump.mjs && git add manifest.json manifest-beta.json versions.json"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@quartz-community/remark-obsidian": "2.2.1",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.38.6",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.1.0",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-plugin-obsidianmd": "^0.5.1",
    "fast-check": "^4.10.2",
    "knip": "^6.45.0",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-gfm-footnote": "^2.1.0",
    "mdast-util-math": "^3.0.0",
    "micromark-extension-gfm-footnote": "^2.1.0",
    "micromark-extension-math": "^3.1.0",
    "obsidian": "^1.13.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "knip": {
    "entry": [
      "scripts/generate-corpora.ts",
      "scripts/oracle/plugin-facts.ts",
      "scripts/oracle/inapp-*.js",
      "scripts/strip-inkscape-icons.mjs",
      "scripts/readme-gifs/record.mjs",
      "scripts/readme-gifs/*.js"
    ],
    "ignore": [
      "vitest.stryker.config.mts",
      "scripts/oracle/generate.d.mts"
    ],
    "ignoreBinaries": [
      "Obsidian.com",
      "ffmpeg",
      "pkill"
    ],
    "ignoreDependencies": [
      "electron"
    ]
  }
}
